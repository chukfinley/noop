<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Live WHOOP strap link (BLE) + optional network. Mirrors the native Android app's
      bluetooth/location/foreground-service/network permission set for the same strap.
      Permissions only here — the BLE logic is requested at runtime (see
      lib/core/ble/permissions.dart). No service component is declared because the
      Flutter app has no such code yet.
    -->

    <!-- Outbound network: opt-in AI Coach (bring-your-own key) + connectivity checks. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Android 12+ (API 31+) Bluetooth runtime permissions.
         neverForLocation: we only read HR/battery from the strap and never derive
         physical location from BLE scans, so we opt out of the location requirement. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation"
        tools:targetApi="s" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="s" />
    <!-- Optional: broadcast live HR back out as a standard BLE Heart Rate peripheral. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADVERTISE"
        tools:targetApi="s" />

    <!-- Android 8-11 (API 26-30): legacy Bluetooth perms are install-time. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Pre-12 (API <=30) only: BLE scans required a location permission. On API 31+ the
         neverForLocation flag above removes that requirement, so this is capped at 30. -->
    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION"
        android:maxSdkVersion="30" />

    <!-- Keep the BLE link alive while collecting/offloading in the background. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE"
        tools:targetApi="34" />

    <!-- Let the user exempt NOOP from battery optimisation so the OS doesn't throttle/kill the
         background offload mid-sync. Requested at runtime; sync still works (less reliably) if declined. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Android 13+ (API 33+): show the low-key persistent "WHOOP sync" foreground-service
         notification. Requested at runtime; the service still runs if the user declines. -->
    <uses-permission
        android:name="android.permission.POST_NOTIFICATIONS"
        tools:targetApi="33" />

    <!-- WorkManager killed-app sync (workmanager plugin → androidx.work). WorkManager needs a
         wakelock to run the headless offload isolate, and RECEIVE_BOOT_COMPLETED to re-enqueue the
         periodic job after a reboot. Both are also contributed by androidx.work's manifest merge;
         declared here explicitly so the intent is visible and survives any merge suppression. The
         WorkManagerInitializer provider, SystemJobService/SystemAlarmService components and the
         plugin's POST_NOTIFICATIONS are supplied by the libraries — nothing else is needed here. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- BLE is used but not mandatory hardware (app also runs on desktop). -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="false" />

    <!-- Accelerometer drives the gravity-levelling "water" gauges. No runtime
         permission is needed for the accelerometer; declared non-required so the
         app still installs on devices without one (desktop). -->
    <uses-feature
        android:name="android.hardware.sensor.accelerometer"
        android:required="false" />

    <application
        android:label="NOOP"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- flutter_foreground_task's persistent foreground service. The class name is fixed by
             the plugin (do not rename). connectedDevice type = we hold an active BLE link to the
             WHOOP strap; reuses the already-declared FOREGROUND_SERVICE(+_CONNECTED_DEVICE) perms.
             stopWithTask=false so the service (and its sync + notification) SURVIVES the user
             swiping the app away — matching the original app. The periodic WorkManager job
             (background_sync_worker.dart) still complements it after a full process kill. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="connectedDevice"
            android:stopWithTask="false"
            android:exported="false" />

        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
